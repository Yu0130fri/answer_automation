# Copy this file to .env and fill with your real credentials.
# Keep .env in .gitignore and do NOT commit your secrets to git.

# Moppy login email
EMAIL=your@email.com

# Moppy login password
PASSWORD=yourpassword

# Optional: number of parallel Chrome workers (overrides --threads)
# THREADS=3

# Optional: if set to '1', saved state (.moppy_parallel_state.json) will be ignored
# RESET_STATE=0
